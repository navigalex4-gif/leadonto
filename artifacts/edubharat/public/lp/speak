.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(255,106,0,.44);}
.btn-primary:active{transform:translateY(0);}
.btn-ghost{background:rgba(255,255,255,.09);color:#fff;border:1.5px solid rgba(255,255,255,.28);}
.btn-ghost:hover{background:rgba(255,255,255,.16);}
.btn-dark{background:var(--navy);color:#fff;}
